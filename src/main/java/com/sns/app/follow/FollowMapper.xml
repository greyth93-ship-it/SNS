<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sns.app.follow.FollowMapper">

	<insert id="follow" parameterType="FollowDTO"
		useGeneratedKeys="true" keyProperty="followNo">
		INSERT INTO "FOLLOW"
		VALUES (
		default,
		#{userFollower},
		now(),
		#{userFollowing}
		)

	</insert>

	<select id="detail" parameterType="FollowDTO"
		resultMap="detailResult">
		SELECT u.*,ui.*,r.*,f.*,p."FEED_NO",p."USER_NO" AS "POST_USER_NO"
		FROM "FOLLOW" f
		INNER JOIN "USER" u ON
		u."USER_NO" = f."USER_FOLLOWING"
		LEFT JOIN "USER_IMG" ui
		USING
		("USER_NO")
		LEFT JOIN "USER_ROLE"
		USING ("USER_NO")
		LEFT JOIN "ROLE" r
		USING ("ROLE_NO")
		LEFT JOIN "POST" p
		ON p."USER_NO" = u."USER_NO"
		WHERE u."USER_ID"=#{username}
	</select>

	<resultMap id="detailResult" type="FollowDTO">
		<id column="FOLLOW_NO" property="followNo" />
		<result column="USER_FOLLOWER" property="userFollower" />
		<result column="FOLLOW_DATE" property="followDate" />
		<result column="USER_FOLLOWING" property="userFollowing" />
		<result column="FEED_NO" property="feedNo" />

		<association property="memberDTO" javaType="MemberDTO">
			<result column="USER_NO" property="userNo" />
			<result column="USER_NICKNAME" property="userNickname" />

			<association property="profileDTO" javaType="ProfileDTO">
				<id column="PROFILE_FILE_NO" property="fileNo" />
				<result column="PROFILE_FILE_NAME" property="fileName" />
				<result column="PROFILE_ORI_NAME" property="oriName" />
			</association>

		</association>
	</resultMap>

	<delete id="delete" parameterType="FollowDTO">
		DELETE FROM "FOLLOW"
		WHERE
		FOLLOW_NO = #{followNo}
	</delete>




</mapper>